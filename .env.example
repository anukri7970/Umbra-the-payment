# Umbra — environment variables
# Copy to .env and fill in values after deployment

# ── Required after Preprod deployment ────────────────────────────────────────
# Set this to the contract address output by GitHub Actions
VITE_CONTRACT_ADDRESS=

# ── Network (do not change for Preprod) ──────────────────────────────────────
VITE_NETWORK=preprod

# ── Midnight Preprod endpoints (defaults — no need to change) ─────────────────
VITE_INDEXER_HTTP=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# ── 1AM ProofStation (required for 1AM wallet compatibility) ─────────────────
# IMPORTANT: Do NOT use the default Midnight proof server — it produces ZK
# proofs incompatible with the 1AM wallet (Error 182).
VITE_PROOF_SERVER=https://api-preprod.1am.xyz
